---
// Shell for the overyondrdev.com portal pages (not part of the V1 site).
// Yondr 2026 brand: Dark Green #1c300b, Lichen #daff6b, Off White #f4f9d1, Off Black #1e1e1e;
// Exposure (display serif) + Milling (sans). Assets live in /brand (official files from the Brand Hub).
interface Props { title: string; description?: string }
const { title, description = 'Private preview of the Yondr website.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1c300b" />
    <title>{title}</title>
    <link rel="icon" href="/brand/icons/circle-lichen.png" />
    <link rel="preload" href="/brand/fonts/exposure.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/brand/fonts/milling.woff2" as="font" type="font/woff2" crossorigin />
    <style is:global>
      @font-face { font-family: 'Exposure'; src: url(/brand/fonts/exposure.woff2) format('woff2'); font-display: swap; }
      @font-face { font-family: 'Milling'; src: url(/brand/fonts/milling.woff2) format('woff2'); font-display: swap; }
      :root {
        --green: #1c300b; --green-2: #243d10; --green-3: #2f4d16; --deep: #12210a;
        --lichen: #daff6b; --off-white: #f4f9d1; --off-black: #1e1e1e;
        --muted: rgb(244 249 209 / .68); --line: rgb(244 249 209 / .14);
        --radius: 20px; --ease: cubic-bezier(.2, .7, .2, 1);
        --serif: 'Exposure', 'Iowan Old Style', Georgia, serif;
        --sans: 'Milling', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;
        color-scheme: dark;
      }
      *, *::before, *::after { box-sizing: border-box; }
      html, body { margin: 0; }
      body {
        min-height: 100vh; min-height: 100dvh; display: flex; flex-direction: column;
        background: var(--green); color: var(--off-white); font: 400 16px/1.55 var(--sans);
        -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility;
        background-image: radial-gradient(1200px 600px at 85% -10%, rgb(218 255 107 / .09), transparent 60%),
                          radial-gradient(900px 500px at -10% 110%, rgb(0 0 0 / .25), transparent 60%);
      }
      a { color: inherit; }
      :focus-visible { outline: 3px solid var(--lichen); outline-offset: 4px; border-radius: 6px; }
      .wrap { width: 100%; max-width: 1160px; margin: 0 auto; padding: 0 24px; }
      .skip { position: absolute; left: -9999px; top: 8px; background: var(--lichen); color: var(--green); padding: 8px 14px; border-radius: 8px; font-weight: 700; z-index: 10; }
      .skip:focus { left: 16px; }

      /* Top bar */
      .top { padding: 22px 0; }
      .top .wrap { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
      .brand { display: inline-flex; align-items: center; gap: 12px; text-decoration: none; }
      .brand img { width: 104px; height: auto; display: block; }
      .brand span { font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); padding-left: 12px; border-left: 1px solid var(--line); }
      .who { display: flex; align-items: center; gap: 10px; font-size: 14px; color: var(--muted); min-width: 0; }
      .who .email { color: var(--off-white); max-width: 26ch; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .who .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--lichen); box-shadow: 0 0 0 4px rgb(218 255 107 / .18); flex: none; }
      .who a { color: var(--off-white); text-decoration: none; border: 1px solid var(--line); padding: 6px 12px; border-radius: 999px; transition: border-color .2s, background .2s; white-space: nowrap; }
      .who a:hover { border-color: var(--lichen); background: rgb(218 255 107 / .08); }
      .who[data-anon] .signed { display: none; }

      main { flex: 1; display: flex; align-items: center; padding: 24px 0 56px; }
      .eyebrow { display: inline-flex; align-items: center; gap: 10px; margin: 0 0 18px; font-size: 13px; letter-spacing: .16em; text-transform: uppercase; color: var(--lichen); }
      .eyebrow img { width: 22px; height: 22px; }
      h1 { font: 400 clamp(2.6rem, 6.2vw, 4.75rem)/1.02 var(--serif); letter-spacing: -.01em; margin: 0 0 18px; color: var(--off-white); }
      h1 em { font-style: normal; color: var(--lichen); }
      .lede { margin: 0 0 44px; max-width: 54ch; font-size: 18px; color: var(--muted); }

      /* Checker strip (Yondr border pattern) */
      .checker { height: 14px; background: repeating-linear-gradient(90deg, var(--lichen) 0 14px, transparent 14px 28px); opacity: .9; }
      .site-foot { padding: 0 0 28px; color: var(--muted); font-size: 14px; }
      .site-foot .wrap { display: flex; flex-wrap: wrap; gap: 12px 24px; justify-content: space-between; align-items: center; padding-top: 22px; }
      .site-foot nav { display: flex; flex-wrap: wrap; gap: 8px 22px; }
      .site-foot a { text-decoration: none; color: var(--off-white); opacity: .8; }
      .site-foot a:hover { opacity: 1; text-decoration: underline; text-underline-offset: 4px; }

      @media (max-width: 640px) {
        .brand span { display: none; }
        .who .signed, .who .dot { display: none; }
        .lede { font-size: 16px; margin-bottom: 32px; }
      }
      @media (prefers-reduced-motion: reduce) { *, *::before, *::after { transition: none !important; animation: none !important; } }
    </style>
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="top">
      <div class="wrap">
        <a class="brand" href="https://overyondrdev.com/" aria-label="Yondr website preview — home">
          <img src="/brand/yondr-lichen.svg" alt="Yondr" width="104" height="25" />
          <span>Website preview</span>
        </a>
        <div class="who" data-who data-anon>
          <span class="dot" aria-hidden="true"></span>
          <span class="signed"><span class="label">Signed in as </span><span class="email" data-user-email></span></span>
          <a href="/cdn-cgi/access/logout">Sign out</a>
        </div>
      </div>
    </header>
    <main id="main"><div class="wrap"><slot /></div></main>
    <footer class="site-foot">
      <div class="checker" aria-hidden="true"></div>
      <div class="wrap">
        <span>© 2026 Yondr, Inc. · Internal preview — please don't share links externally.</span>
        <nav aria-label="Footer">
          <a href="https://www.overyondr.com/" rel="noopener">Live site ↗</a>
          <a href="mailto:marketing@overyondr.com">Need access? marketing@overyondr.com</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
