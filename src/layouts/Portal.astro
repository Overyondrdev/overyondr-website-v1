---
// Shell for the overyondrdev.com portal pages (not part of the V1 site).
// Follows the Yondr Brand Guidelines v1.0: Paper page, one Dark Green panel, Fraunces + Inter Tight.
// Assets live in /brand (official wordmarks from the Brand Hub; fonts are the free OFL releases).
interface Props { title: string; description?: string }
const { title, description = 'Private preview of the Yondr website.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FAFBF7" />
    <title>{title}</title>
    <link rel="icon" href="/brand/yondr-dark-green.svg" type="image/svg+xml" />
    <link rel="preload" href="/brand/fonts/fraunces-latin-500-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/brand/fonts/inter-tight-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <style is:global>
      @font-face { font-family: 'Fraunces'; src: url(/brand/fonts/fraunces-latin-400-normal.woff2) format('woff2'); font-weight: 400; font-display: swap; }
      @font-face { font-family: 'Fraunces'; src: url(/brand/fonts/fraunces-latin-500-normal.woff2) format('woff2'); font-weight: 500; font-display: swap; }
      @font-face { font-family: 'Inter Tight'; src: url(/brand/fonts/inter-tight-latin-400-normal.woff2) format('woff2'); font-weight: 400; font-display: swap; }
      @font-face { font-family: 'Inter Tight'; src: url(/brand/fonts/inter-tight-latin-600-normal.woff2) format('woff2'); font-weight: 600; font-display: swap; }
      @font-face { font-family: 'Inter Tight'; src: url(/brand/fonts/inter-tight-latin-700-normal.woff2) format('woff2'); font-weight: 700; font-display: swap; }
      /* Yondr Brand Guidelines v1.0, section 1 (design tokens). */
      :root {
        --yondr-forest: #1C300B; --yondr-ink: #1E1E1E; --yondr-lichen: #DAFF6B;
        --yondr-offwhite: #F4F9D1; --yondr-paper: #FAFBF7; --yondr-mist: #E7ECDF;
        --yondr-stone: #D3D6C8; --yondr-sage: #9DAE7E; --yondr-moss: #4F6B35;
        --yondr-forest-deep: #2A4216;
        --yondr-font-display: 'Fraunces', Georgia, serif;
        --yondr-font-text: 'Inter Tight', Arial, sans-serif;
        --yondr-radius: 16px;
        --ease: cubic-bezier(.2, .7, .2, 1);
      }
      *, *::before, *::after { box-sizing: border-box; }
      html, body { margin: 0; }
      body {
        min-height: 100vh; min-height: 100dvh; display: flex; flex-direction: column;
        background: var(--yondr-paper); color: var(--yondr-ink); font: 400 16px/1.5 var(--yondr-font-text);
        -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility;
      }
      a { color: inherit; }
      :focus-visible { outline: 3px solid var(--yondr-forest); outline-offset: 4px; border-radius: 6px; }
      .dark :focus-visible { outline-color: var(--yondr-lichen); }
      .wrap { width: 100%; max-width: 1200px; margin: 0 auto; padding: 0 24px; }
      .skip { position: absolute; left: -9999px; top: 8px; background: var(--yondr-forest); color: var(--yondr-offwhite); padding: 8px 14px; border-radius: 8px; font-weight: 700; z-index: 10; }
      .skip:focus { left: 16px; }
      .eyebrow { margin: 0 0 16px; font: 600 13px/1.4 var(--yondr-font-text); letter-spacing: .14em; text-transform: uppercase; color: var(--yondr-moss); }
      .dark .eyebrow { color: var(--yondr-lichen); }

      /* Top bar */
      .top { padding: 24px 0; }
      .top .wrap { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px 16px; }
      .brand { display: inline-flex; align-items: center; gap: 14px; text-decoration: none; }
      .brand img { width: 104px; height: auto; display: block; }
      .brand span { font-size: 12px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--yondr-moss); padding-left: 14px; border-left: 1px solid var(--yondr-stone); }
      .who { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 10px; font-size: 14px; color: var(--yondr-moss); min-width: 0; }
      .who .signed { display: inline-flex; align-items: baseline; min-width: 0; max-width: 100%; white-space: nowrap; }
      .who .label { flex-shrink: 0; }
      /* inline-block so max-width applies: long addresses end in an ellipsis (full address in the title) */
      .who .email { display: inline-block; vertical-align: bottom; margin-left: .25em; color: var(--yondr-ink); font-weight: 600; max-width: 26ch; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .who a, .who button { font: inherit; cursor: pointer; background: transparent; color: var(--yondr-forest); font-weight: 600; text-decoration: none; border: 1px solid var(--yondr-stone); padding: 7px 14px; border-radius: 999px; transition: border-color .2s, background .2s; white-space: nowrap; }
      .who a:hover, .who button:hover { border-color: var(--yondr-forest); background: var(--yondr-mist); }
      .who .give { display: inline-flex; align-items: center; gap: 8px; background: var(--yondr-forest); border-color: var(--yondr-forest); color: var(--yondr-offwhite); font-weight: 700; }
      .who .give:hover { background: var(--yondr-forest-deep); border-color: var(--yondr-forest-deep); }
      .who[data-anon] .signed { display: none; }
      .who a[hidden] { display: none; }

      main { flex: 1; padding: 8px 0 48px; }

      .site-foot { padding: 0 0 32px; color: var(--yondr-moss); font-size: 14px; }
      .site-foot .rule { display: flex; flex-wrap: wrap; gap: 12px 28px; justify-content: space-between; align-items: center; border-top: 2px solid var(--yondr-stone); padding-top: 24px; }
      .tagline { font: 500 22px/1 var(--yondr-font-display); color: var(--yondr-forest); margin: 0; }
      .site-foot small { font-size: 14px; }
      .site-foot nav { display: flex; flex-wrap: wrap; gap: 8px 22px; }
      .site-foot a { text-decoration: none; color: var(--yondr-forest); font-weight: 600; }
      .site-foot a svg { vertical-align: -2px; margin-left: 2px; }
      .site-foot a:hover { text-decoration: underline; text-underline-offset: 4px; }

      /* Motion (guidelines §6): fade and rise, 0.7 s, staggered 0.1 s; nothing loops. */
      @keyframes rise { from { opacity: 0; transform: translateY(14px); } }
      .rise { animation: rise .7s var(--ease) both; animation-delay: calc(var(--i, 0) * .1s); }

      @media (max-width: 640px) {
        .brand span { display: none; }
        .who .signed { display: none; }
        .who a, .who button { padding: 6px 12px; font-size: 13px; }
      }
      /* When the top bar wraps (tablet widths), give "Signed in as" its own line so no button is left alone on a row. */
      @media (min-width: 641px) and (max-width: 1100px) { .who .signed { flex-basis: 100%; } }
      /* Touch screens: 44px targets for the top-bar pills and footer links. */
      @media (pointer: coarse) {
        .who a, .who button { min-height: 44px; display: inline-flex; align-items: center; }
        .who a[hidden] { display: none; }
        .site-foot a { display: inline-flex; align-items: center; min-height: 44px; }
      }
      @media (prefers-reduced-motion: reduce) { *, *::before, *::after { transition: none !important; animation: none !important; } }
    </style>
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="top">
      <div class="wrap">
        <a class="brand" href="https://overyondrdev.com/" aria-label="Yondr website preview — home">
          <img src="/brand/yondr-dark-green.svg" alt="Yondr" width="104" height="25" />
          <span>Website preview</span>
        </a>
        <div class="who" data-who data-anon>
          <span class="signed"><span class="label">Signed in as</span><span class="email" data-user-email></span></span>
          <button type="button" data-yfb-tour>Take the tour</button>
          <button type="button" class="give" data-yfb-open aria-label="Give feedback">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12Z"/><path d="M8.5 12h.01M12 12h.01M15.5 12h.01" stroke-width="2.6"/></svg>
            Give feedback
          </button>
          <a href="https://overyondrdev.com/admin" data-admin-link hidden>Feedback dashboard</a>
          <a href="/cdn-cgi/access/logout">Sign out</a>
        </div>
      </div>
    </header>
    <main id="main"><div class="wrap"><slot /></div></main>
    <footer class="site-foot">
      <div class="wrap"><div class="rule">
        <p class="tagline">Be Here Now</p>
        <small>© 2026 Yondr, Inc. · Internal preview. Please don't share links outside Yondr.</small>
        <nav aria-label="Footer">
          <a href="https://www.overyondr.com/" rel="noopener">Live site<svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
          <a href="mailto:marketing@overyondr.com">Need access? marketing@overyondr.com</a>
        </nav>
      </div></div>
    </footer>
    <script is:inline>
      // Full address on hover when a long email is cut off with an ellipsis.
      document.querySelectorAll('[data-user-email]').forEach(function (el) { if (el.textContent) el.title = el.textContent; });
    </script>
  </body>
</html>
