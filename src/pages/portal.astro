---
// Served at https://overyondrdev.com/ by the Worker (src/worker/index.js), which also fills in
// the signed-in email from Cloudflare Access.
import Portal from '../layouts/Portal.astro';
const versions = [
  {
    key: '1', href: 'https://v1.overyondrdev.com/', name: 'V1', variant: 'v1',
    tag: 'Live replica',
    blurb: 'Today’s overyondr.com, rebuilt off Squarespace. Every page, image and URL carried over, now faster and self-hosted.',
    facts: ['208 pages', 'Same URLs as overyondr.com'],
  },
  {
    key: '2', href: 'https://v2.overyondrdev.com/', name: 'V2', variant: 'v2',
    tag: 'Work in progress',
    blurb: 'The Loba redesign, a work in progress on the way to our new website. Explore it and tell us what works and what doesn’t.',
    facts: ['90 pages', 'New information architecture'],
  },
];
---
<Portal title="Yondr Website Preview">
  <style>
    /* One Dark Green statement panel holds the choice (guidelines §4, §6). */
    .statement { background: var(--yondr-forest); color: var(--yondr-offwhite); border-radius: var(--yondr-radius); padding: clamp(28px, 5vw, 64px); }
    h1 { font: 500 clamp(2.5rem, 5.6vw, 4.5rem)/1.04 var(--yondr-font-display); letter-spacing: -.02em; margin: 0 0 18px; color: var(--yondr-offwhite); }
    h1 em { font-style: normal; color: var(--yondr-lichen); }
    .lede { margin: 0 0 40px; max-width: 56ch; font-size: 18px; line-height: 1.5; color: var(--yondr-sage); }

    .cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
    .card {
      display: flex; flex-direction: column; border-radius: var(--yondr-radius); overflow: hidden; text-decoration: none;
      background: var(--yondr-forest-deep); color: var(--yondr-offwhite);
      transition: transform .35s var(--ease), box-shadow .35s var(--ease);
    }
    .card:hover { transform: translateY(-4px); box-shadow: 0 24px 48px -24px rgb(0 0 0 / .6); }
    .card:focus-visible { outline-offset: 6px; border-radius: var(--yondr-radius); }
    .media { aspect-ratio: 16 / 9; overflow: hidden; background: var(--yondr-forest); }
    .media img { width: 100%; height: 100%; object-fit: cover; object-position: top; display: block; transition: transform .6s var(--ease); }
    .card:hover .media img { transform: scale(1.03); }
    .body { display: flex; flex-direction: column; gap: 14px; padding: 28px 32px 32px; flex: 1; }
    .row { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; }
    .tag { font: 700 12px/1 var(--yondr-font-text); letter-spacing: .08em; text-transform: uppercase; white-space: nowrap; padding: 7px 12px; border-radius: 999px; background: var(--yondr-lichen); color: var(--yondr-forest); }
    .last { white-space: nowrap; font-size: 12px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--yondr-sage); }
    .last[hidden] { display: none; }
    kbd { margin-left: auto; font: 600 12px/1 var(--yondr-font-text); padding: 5px 8px; border-radius: 6px; border: 1px solid var(--yondr-sage); color: var(--yondr-sage); }
    h2 { font: 500 clamp(2.25rem, 3.6vw, 3rem)/1 var(--yondr-font-display); margin: 4px 0 0; letter-spacing: -.02em; color: var(--yondr-offwhite); }
    h2 small { display: block; font: 600 12px/1.4 var(--yondr-font-text); letter-spacing: .14em; text-transform: uppercase; color: var(--yondr-sage); margin-bottom: 8px; }
    .blurb { margin: 0; font-size: 16px; color: var(--yondr-offwhite); }
    .facts { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 4px 20px; font-size: 14px; color: var(--yondr-sage); }
    .cta { margin-top: auto; align-self: flex-start; display: inline-flex; align-items: center; gap: 10px;
           font-weight: 700; font-size: 15px; padding: 13px 20px; border-radius: 999px; background: var(--yondr-offwhite); color: var(--yondr-forest); }
    .cta svg { transition: transform .25s var(--ease); }
    .card:hover .cta svg { transform: translateX(4px); }

    .hint { margin: 20px 0 0; font-size: 14px; color: var(--yondr-moss); }
    .hint kbd { margin: 0 2px; border-color: var(--yondr-stone); color: var(--yondr-forest); background: var(--yondr-offwhite); }
    @media (max-width: 860px) { .cards { grid-template-columns: 1fr; } .lede { font-size: 16px; margin-bottom: 28px; } .body { padding: 24px; } }
    @media (hover: none) { .hint, .card kbd { display: none; } }
  </style>

  <section class="statement dark rise" aria-labelledby="choose">
    <p class="eyebrow">Yondr website preview</p>
    <h1 id="choose">Choose a version <em>to explore.</em></h1>
    <p class="lede">Both versions are private to the Yondr team. Use Give feedback in the top bar, here or on any page, to tell us what works and what doesn’t.</p>

    <div class="cards">
      {versions.map((v, i) => (
        <a class="card rise" style={`--i:${i + 2}`} href={v.href} data-version={v.variant} data-key={v.key}
           aria-label={`Open Yondr Website ${v.name}: ${v.tag}`}>
          <div class="media" aria-hidden="true">
            <img src={`/brand/${v.variant}-preview.webp`} alt="" width="1200" height="650" />
          </div>
          <div class="body">
            <div class="row">
              <span class="tag">{v.tag}</span>
              <span class="last" data-last hidden>Last opened</span>
              <kbd aria-hidden="true">{v.key}</kbd>
            </div>
            <h2><small>Yondr Website</small>{v.name}</h2>
            <p class="blurb">{v.blurb}</p>
            <ul class="facts">{v.facts.map((f) => <li>{f}</li>)}</ul>
            <span class="cta">Open {v.name}
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>
  <p class="hint">Tip: press <kbd>1</kbd> or <kbd>2</kbd> to jump straight in.</p>

  <script is:inline>
    (function () {
      var KEY = 'yondr-portal-last';
      var last = null;
      try { last = localStorage.getItem(KEY); } catch (e) {}
      document.querySelectorAll('.card').forEach(function (card) {
        if (last && card.dataset.version === last) card.querySelector('[data-last]').hidden = false;
        card.addEventListener('click', function () { try { localStorage.setItem(KEY, card.dataset.version); } catch (e) {} });
      });
      document.addEventListener('keydown', function (e) {
        if (e.metaKey || e.ctrlKey || e.altKey || /input|textarea/i.test(e.target.tagName)) return;
        var card = document.querySelector('.card[data-key="' + e.key + '"]');
        if (card) card.click();
      });
    })();
  </script>
</Portal>
