---
// The Yondr Dev Portal home: served at https://overyondrdev.com/ by the Worker (src/worker/index.js), which fills in
// the signed-in email from the Yondr Google sign-in. Everyone signs in once (Google, @overyondr.com only) and picks a
// portal here. To add a portal: one entry below (keep `key` 1–9 unique), plus its host in auth/src/pages.js SITES.
import Portal from '../layouts/Portal.astro';

const portals = [
  {
    key: '1', id: 'website', href: '/website', host: 'overyondrdev.com/website',
    name: 'Website Review', kicker: 'Review & feedback',
    blurb: 'Explore today’s site and the redesign side by side, and leave feedback on any page.',
    cta: 'Review the website',
    icon: '<rect x="3" y="4" width="18" height="14" rx="2.5"/><path d="M3 8.5h18M7 6.25h.01M9.5 6.25h.01"/><path d="M8 21h8M12 18v3"/>',
  },
  {
    key: '2', id: 'requests', href: 'https://requests.overyondrdev.com/', host: 'requests.overyondrdev.com',
    name: 'Marketing Requests', kicker: 'Ask the marketing team',
    blurb: 'Request work from marketing, share a brief, and follow it all the way to delivery.',
    cta: 'Make a request',
    icon: '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13h6M9 17h4"/>',
  },
  {
    key: '3', id: 'ads', href: 'https://ads.overyondrdev.com/', host: 'ads.overyondrdev.com',
    name: 'Ad Campaigns', kicker: 'Display ad library',
    blurb: 'Browse, review and download Yondr’s display ads, and update their copy.',
    cta: 'Open the ad library',
    icon: '<path d="M4 10v4a1 1 0 0 0 1 1h2l5 4V5L7 9H5a1 1 0 0 0-1 1Z"/><path d="M16 9a4 4 0 0 1 0 6M18.5 6.5a7.5 7.5 0 0 1 0 11"/>',
  },
  {
    key: '4', id: 'cards', href: 'https://cards.overyondrdev.com/', host: 'cards.overyondrdev.com',
    name: 'Christmas Card Request', kicker: 'Client gifting', seasonal: true,
    blurb: 'Add the clients who should receive a Yondr Christmas card this year.',
    cta: 'Add card recipients',
    icon: '<rect x="3" y="8" width="18" height="13" rx="2"/><path d="M12 8v13M3 12.5h18"/><path d="M12 8c-1.5-3.5-6-4-6-1.25C6 8 9 8 12 8Zm0 0c1.5-3.5 6-4 6-1.25C18 8 15 8 12 8Z"/>',
  },
];
const arrow = '<path d="M5 12h14M13 6l6 6-6 6"/>';

// Announced but not built yet: shown as muted cards, not links. When one launches, move it into `portals` above.
const comingSoon = [
  {
    id: 'assets', name: 'Asset Library',
    blurb: 'Find approved photos, logos, videos and files, ready to download and share.',
    icon: '<rect x="3" y="5" width="18" height="14" rx="2.5"/><circle cx="9" cy="10" r="1.6"/><path d="m21 15-4.5-4.5L8 19"/>',
  },
  {
    id: 'decks', name: 'Deck Builder',
    blurb: 'Build on-brand presentations from approved slides in minutes.',
    icon: '<rect x="3" y="4" width="18" height="12" rx="2"/><path d="M12 16v4M8 20h8M7 9h6M7 12h10"/>',
  },
  {
    id: 'brand', name: 'Brand Guidelines',
    blurb: 'How Yondr looks and sounds: logo, colour, type, voice and examples.',
    icon: '<path d="M12 3a9 9 0 1 0 0 18c1.1 0 1.8-.9 1.5-1.9-.3-1 .4-2.1 1.5-2.1H17a4 4 0 0 0 4-4c0-5-4-10-9-10Z"/><circle cx="7.5" cy="11" r="1"/><circle cx="10.5" cy="7.5" r="1"/><circle cx="15" cy="8" r="1"/>',
  },
];
---
<Portal title="Yondr Dev Portal" description="The Yondr Dev Portal: Website Review, Marketing Requests, Ad Campaigns and Christmas Card Requests.">
  <style>
    /* The page's one Dark Green statement panel (brand guidelines §4, §6), with a soft lichen light in the corner. */
    .hello { position: relative; overflow: hidden; isolation: isolate; margin-bottom: clamp(20px, 3vw, 28px);
      padding: clamp(32px, 6vw, 72px) clamp(24px, 5vw, 64px); border-radius: calc(var(--yondr-radius) + 8px);
      background: var(--yondr-forest); color: var(--yondr-offwhite); }
    .hello::before { content: ''; position: absolute; z-index: -1; inset: -40% -20% auto auto; width: min(720px, 90%); aspect-ratio: 1; border-radius: 50%;
      background: radial-gradient(closest-side, rgb(218 255 107 / .22), rgb(218 255 107 / .06) 55%, transparent); }
    .hello::after { content: ''; position: absolute; z-index: -1; inset: auto auto -55% -15%; width: min(560px, 70%); aspect-ratio: 1; border-radius: 50%;
      background: radial-gradient(closest-side, rgb(157 174 126 / .22), transparent); }
    h1 { font: 500 clamp(2.5rem, 6vw, 4.5rem)/1.03 var(--yondr-font-display); letter-spacing: -.025em; margin: 0 0 18px; color: var(--yondr-offwhite); max-width: 16ch; }
    h1 em { font-style: normal; color: var(--yondr-lichen); }
    .lede { margin: 0; font-size: clamp(17px, 2vw, 20px); line-height: 1.5; color: var(--yondr-sage); max-width: 46ch; }
    .count { display: inline-flex; align-items: center; gap: 10px; margin-top: clamp(24px, 3vw, 32px); font-size: 14px; font-weight: 600; color: var(--yondr-offwhite); }
    .count i { width: 8px; height: 8px; border-radius: 50%; background: var(--yondr-lichen); box-shadow: 0 0 0 5px rgb(218 255 107 / .18); }

    .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(16px, 2vw, 24px); }
    .grid > li { display: flex; }
    .tile {
      position: relative; isolation: isolate; flex: 1; display: grid; grid-template-columns: auto 1fr; gap: 20px 22px; align-content: start;
      padding: clamp(24px, 3vw, 36px); border-radius: calc(var(--yondr-radius) + 4px); text-decoration: none; overflow: hidden;
      background: #fff; color: var(--yondr-ink); border: 1px solid var(--yondr-stone);
      box-shadow: 0 1px 0 rgb(28 48 11 / .04);
      transition: transform .35s var(--ease), box-shadow .35s var(--ease), border-color .35s var(--ease), background .35s var(--ease);
    }
    /* A soft lichen glow that follows the card's corner on hover. */
    .tile::after { content: ''; position: absolute; inset: auto -30% -60% auto; width: 70%; aspect-ratio: 1; border-radius: 50%;
      background: radial-gradient(closest-side, rgb(218 255 107 / .55), transparent); opacity: 0; transition: opacity .45s var(--ease); z-index: -1; }
    .tile:hover { transform: translateY(-4px); border-color: var(--yondr-forest); box-shadow: 0 28px 56px -32px rgb(28 48 11 / .45); }
    .tile:hover::after, .tile:focus-visible::after { opacity: 1; }
    .tile:focus-visible { outline: 3px solid var(--yondr-forest); outline-offset: 4px; }
    .tile:active { transform: translateY(-1px); }

    .icon { grid-row: span 2; width: 64px; height: 64px; border-radius: 18px; display: grid; place-items: center;
      background: var(--yondr-forest); color: var(--yondr-lichen); transition: transform .35s var(--ease), background .35s var(--ease); }
    .icon svg { width: 30px; height: 30px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
    .tile:hover .icon { transform: rotate(-4deg) scale(1.04); }

    .head { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 10px; min-width: 0; }
    .kicker { font: 600 12px/1.2 var(--yondr-font-text); letter-spacing: .12em; text-transform: uppercase; color: var(--yondr-moss); }
    .pill { font: 700 11px/1 var(--yondr-font-text); letter-spacing: .08em; text-transform: uppercase; padding: 6px 10px; border-radius: 999px; white-space: nowrap; }
    .pill.season { background: var(--yondr-lichen); color: var(--yondr-forest); }
    .pill.last { background: var(--yondr-mist); color: var(--yondr-forest); }
    .pill[hidden] { display: none; }
    kbd { margin-left: auto; font: 600 12px/1 var(--yondr-font-text); padding: 5px 8px; border-radius: 6px; border: 1px solid var(--yondr-stone); color: var(--yondr-moss); background: var(--yondr-paper); }
    h2 { grid-column: 2; font: 500 clamp(1.75rem, 2.6vw, 2.25rem)/1.08 var(--yondr-font-display); letter-spacing: -.02em; margin: -6px 0 0; color: var(--yondr-forest); }
    .blurb { grid-column: 1 / -1; margin: 0; font-size: 16px; line-height: 1.55; color: var(--yondr-ink); max-width: 46ch; }
    .foot { grid-column: 1 / -1; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px 16px; margin-top: 6px; }
    .cta { display: inline-flex; align-items: center; gap: 10px; font-weight: 700; font-size: 15px; padding: 12px 18px; border-radius: 999px;
      background: var(--yondr-forest); color: var(--yondr-offwhite); transition: background .25s var(--ease); }
    .cta svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; transition: transform .25s var(--ease); }
    .tile:hover .cta { background: var(--yondr-forest-deep); }
    .tile:hover .cta svg { transform: translateX(4px); }
    .host { font-size: 13px; color: var(--yondr-moss); overflow-wrap: anywhere; }

    /* Coming soon: smaller, muted, not interactive. */
    .soon { margin-top: clamp(28px, 4vw, 40px); }
    .soon h2.soon-h { grid-column: auto; margin: 0 0 14px; font: 600 13px/1.4 var(--yondr-font-text); letter-spacing: .14em; text-transform: uppercase; color: var(--yondr-moss); }
    .soon ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(12px, 1.6vw, 18px); }
    .soon li { display: grid; grid-template-columns: auto 1fr; gap: 6px 14px; align-items: start; padding: 18px 20px;
      border-radius: var(--yondr-radius); border: 1px dashed var(--yondr-stone); background: var(--yondr-paper); color: var(--yondr-ink); }
    .soon .sicon { grid-row: span 3; width: 44px; height: 44px; border-radius: 12px; display: grid; place-items: center; background: var(--yondr-mist); color: var(--yondr-moss); }
    .soon .sicon svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
    .soon .sname { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; font: 500 1.25rem/1.15 var(--yondr-font-display); color: var(--yondr-forest); }
    .soon .pill.soon-pill { background: var(--yondr-mist); color: var(--yondr-moss); border: 1px solid var(--yondr-stone); }
    .soon p { margin: 0; font-size: 14px; line-height: 1.5; color: var(--yondr-moss); }
    @media (max-width: 860px) { .soon ul { grid-template-columns: 1fr; } }
    .after { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px 24px; margin-top: 28px; }
    .hint { margin: 0; font-size: 14px; color: var(--yondr-moss); }
    .hint kbd { margin: 0 2px; }
    .admin { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 10px; font-size: 14px; color: var(--yondr-moss); }
    .admin[hidden] { display: none; }
    .admin a { text-decoration: none; font-weight: 600; color: var(--yondr-forest); border: 1px solid var(--yondr-stone); padding: 7px 14px; border-radius: 999px; transition: border-color .2s, background .2s; }
    .admin a:hover { border-color: var(--yondr-forest); background: var(--yondr-mist); }

    @media (max-width: 860px) { .grid { grid-template-columns: 1fr; } }
    @media (max-width: 420px) {
      .tile { grid-template-columns: 1fr; gap: 14px; }
      .icon { grid-row: auto; width: 52px; height: 52px; border-radius: 14px; }
      .icon svg { width: 26px; height: 26px; }
      h2 { grid-column: 1; margin: 0; }
      .cta { width: 100%; justify-content: center; }
      .host { display: none; }
      .blurb { font-size: 15px; }
    }
    @media (hover: none) { .hint, .tile kbd { display: none; } }
    @media (pointer: coarse) { .admin a { min-height: 44px; display: inline-flex; align-items: center; } }
  </style>

  <section class="hello dark rise" aria-labelledby="hello">
    <p class="eyebrow">Yondr Dev Portal</p>
    <h1 id="hello"><span data-greeting>Welcome</span><em data-name></em>.</h1>
    <p class="lede">Everything the Yondr team builds and shares, in one place. Where would you like to go?</p>
    <p class="count"><i aria-hidden="true"></i>{portals.length} portals, one sign-in</p>
  </section>

  <nav aria-label="Portals">
    <ul class="grid">
      {portals.map((p, i) => (
        <li class="rise" style={`--i:${i + 1}`}>
          <a class="tile" href={p.href} data-portal={p.id} data-key={p.key} aria-describedby={`d-${p.id}`}>
            <span class="icon" aria-hidden="true"><svg viewBox="0 0 24 24" set:html={p.icon} /></span>
            <span class="head">
              <span class="kicker">{p.kicker}</span>
              {p.seasonal && <span class="pill season">Seasonal</span>}
              <span class="pill last" data-last hidden>Last visited</span>
              <kbd aria-hidden="true">{p.key}</kbd>
            </span>
            <h2>{p.name}</h2>
            <p class="blurb" id={`d-${p.id}`}>{p.blurb}</p>
            <span class="foot">
              <span class="cta">{p.cta}<svg viewBox="0 0 24 24" aria-hidden="true" set:html={arrow} /></span>
              <span class="host">{p.host}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <section class="soon rise" style={`--i:${portals.length + 1}`} aria-labelledby="soon-h">
    <h2 class="soon-h" id="soon-h">Coming soon</h2>
    <ul>
      {comingSoon.map((c) => (
        <li data-soon={c.id}>
          <span class="sicon" aria-hidden="true"><svg viewBox="0 0 24 24" set:html={c.icon} /></span>
          <span class="sname">{c.name} <span class="pill soon-pill">Coming soon</span></span>
          <p>{c.blurb}</p>
        </li>
      ))}
    </ul>
  </section>

  <div class="after">
    <p class="hint">Tip: press <kbd>1</kbd>–<kbd>{portals.length}</kbd> to jump straight in.</p>
    <div class="admin" data-admin-link hidden>
      <span>Admin:</span>
      <a href="https://feedback.overyondrdev.com/admin">Feedback dashboard</a>
      <a href="https://ops.overyondrdev.com/">Yondr Ops</a>
    </div>
  </div>

  <script is:inline>
    (function () {
      // Greeting by time of day, and a first name from the signed-in address (chad.smith@… → Chad).
      var h = new Date().getHours();
      document.querySelector('[data-greeting]').textContent = h < 5 ? 'Welcome' : h < 12 ? 'Good morning' : h < 18 ? 'Good afternoon' : 'Good evening';
      var email = (document.querySelector('[data-user-email]') || {}).textContent || '';
      var first = email.split('@')[0].split(/[._-]/)[0];
      if (/^[a-z]{2,}$/i.test(first)) document.querySelector('[data-name]').textContent = ', ' + first.charAt(0).toUpperCase() + first.slice(1).toLowerCase();

      var KEY = 'yondr-portal-last';
      var last = null;
      try { last = localStorage.getItem(KEY); } catch (e) {}
      document.querySelectorAll('.tile').forEach(function (tile) {
        if (last && tile.dataset.portal === last) tile.querySelector('[data-last]').hidden = false;
        tile.addEventListener('click', function () { try { localStorage.setItem(KEY, tile.dataset.portal); } catch (e) {} });
      });
      document.addEventListener('keydown', function (e) {
        if (e.metaKey || e.ctrlKey || e.altKey || e.defaultPrevented || /input|textarea|select/i.test(e.target.tagName) || e.target.isContentEditable) return;
        var tile = document.querySelector('.tile[data-key="' + e.key + '"]');
        if (tile) tile.click();
      });
    })();
  </script>
</Portal>
