{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "overyondr-website-v1",
  "compatibility_date": "2026-11-20",
  // Static assets only: no Worker script needed for V1.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash"
  },
  "observability": { "enabled": true },
  // Pull requests get a workers.dev preview URL from Cloudflare's preview builds.
  "preview_urls": true,
  // Dev domain: every deploy of main is served here.
  // The production domains (overyondr.com, www) are added only at cutover, after sign-off.
  "routes": [
    { "pattern": "overyondrdev.com", "custom_domain": true },
    { "pattern": "www.overyondrdev.com", "custom_domain": true }
  ]
}
