{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "overyondr-website-v1",
  "compatibility_date": "2026-11-20",
  // Tiny Worker that routes by hostname (portal / V1 / V2) and serves query-string pages. The feedback tool is its
  // own Worker (Overyondrdev/yondr-feedback); this site only embeds its script.
  "main": "src/worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash"
  },
  "observability": { "enabled": true },
  "vars": {
    // Yondr Google sign-in (auth.overyondrdev.com): public key of the shared session cookie. Safe to commit.
    "YONDR_AUTH_PUBLIC_JWK": "{\"kty\":\"EC\",\"crv\":\"P-256\",\"x\":\"BpCjLJMykOsJbtPTm63rdbw2BzRUTNTz3jj9LWqK6AM\",\"y\":\"RyW0y7Dki1BQ6GnYdD-4FPovGYfoaMmDgr21lNU7xXQ\",\"kid\":\"yondr-2026-11-26-a3a7e6\"}",
    "ALLOWED_EMAIL_DOMAINS": "overyondr.com"
  },
  // No public *.workers.dev or preview URLs: they would bypass the sign-in check on the custom domains.
  "workers_dev": false,
  "preview_urls": false,
  // Dev domains. overyondrdev.com = portal, v1. = migrated site, v2. = redesign placeholder.
  // All require the Yondr Google sign-in (@overyondr.com Google accounts; src/worker/yondr-session.js).
  // The production domains (overyondr.com, www) are added only at cutover, after sign-off.
  "routes": [
    { "pattern": "overyondrdev.com", "custom_domain": true },
    { "pattern": "www.overyondrdev.com", "custom_domain": true },
    { "pattern": "v1.overyondrdev.com", "custom_domain": true },
    { "pattern": "v2.overyondrdev.com", "custom_domain": true }
  ]
}
