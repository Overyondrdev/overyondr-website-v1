// yondr-auth: Google sign-in for every *.overyondrdev.com site (https://auth.overyondrdev.com). See README.md.
// Secrets (dashboard → Settings → Variables and Secrets, or `npx wrangler secret put <NAME>`), never committed:
//   GOOGLE_CLIENT_ID      OAuth client ID from Google Cloud (Web application)
//   GOOGLE_CLIENT_SECRET  its client secret
//   SESSION_PRIVATE_JWK   ES256 private key (JSON JWK) that signs sessions; sites hold the matching public key
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "yondr-auth",
  "main": "src/index.js",
  "compatibility_date": "2026-11-20",
  "account_id": "3fac6c19097c5692e17198cffa818085",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "auth.overyondrdev.com", "custom_domain": true }],
  "vars": {
    // Only verified Google Workspace accounts of these domains can sign in (hd claim and email both checked).
    "ALLOWED_EMAIL_DOMAINS": "overyondr.com",
    // Google Workspace organization (primary domain) whose accounts may sign in: Google's `hd` claim. Usually the same
    // as above; if overyondr.com is a secondary domain of your Workspace, put the primary domain here.
    "ALLOWED_WORKSPACE_DOMAINS": "overyondr.com",
    // The session cookie is shared by this domain and all its subdomains; sign-in only returns to these hosts.
    "SITE_DOMAIN": "overyondrdev.com",
    "SESSION_HOURS": "12",
    "DIRECTORY_SHEET_ID": "1ZH-_cFxZ2dlYUC37wVrs8cZDcEu95oh6Eop7LlWSCkU",
  },
  // People directory (src/directory.js): the Yondr Team Contact List sheet, copied into KV 4 times a day
  // (01:23, 07:23, 13:23, 19:23 UTC). Secret DIRECTORY_SA_KEY = the read-only service account's JSON key (README).
  "kv_namespaces": [{ "binding": "DIRECTORY", "id": "5339d6576e0f40ca83134966a8d50536" }],
  "triggers": { "crons": ["23 1,7,13,19 * * *"] },
  // The shared autofill script is served as text.
  "rules": [{ "type": "Text", "globs": ["**/*.client.js"], "fallthrough": false }],
  "observability": { "enabled": true },
}
