# Keep the dev domain and preview URLs out of search results.
# overyondr.com is not listed here, so production stays indexable at cutover.
https://overyondrdev.com/*
  X-Robots-Tag: noindex

https://www.overyondrdev.com/*
  X-Robots-Tag: noindex

https://v1.overyondrdev.com/*
  X-Robots-Tag: noindex

https://:worker.:subdomain.workers.dev/*
  X-Robots-Tag: noindex

# Brand kit (official files from the Yondr Brand Hub). CORS allows the Access sign-in page to use the
# fonts if /brand is ever made public; today it is behind Access like everything else.
/brand/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=86400
